# ==============================================================================
# HUMofA (Humanize of AI) - Environment Configuration Template
# ==============================================================================
#
# OFFLINE MOCK FALLBACK MECHANISM:
# HUMofA features a zero-dependency offline mock fallback architecture.
# When any API key, bot token, or remote service endpoint is left blank, commented out,
# or explicitly set to "mock" or "offline", HUMofA automatically activates deterministic
# in-memory mock/stub providers for that subsystem.
#
# This allows:
# 1. 100% offline automated test execution via `dotnet test` with zero external credentials.
# 2. Complete local development and debugging without active network access.
# 3. Deterministic simulations of multi-channel messaging, LLM reasoning, and execution backends.
#
# To enable live services, copy this file to `.env` and fill in real production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Host Settings
# ------------------------------------------------------------------------------
HUMOFA_ENVIRONMENT=Development
HUMOFA_HOST_PORT=5000
HUMOFA_HOST_URL=http://localhost:5000
HUMOFA_HEADLESS=false
HUMOFA_LOG_LEVEL=Information

# ------------------------------------------------------------------------------
# 2. Multi-Model LLM Providers (Dynamic Multi-Model Router)
# When keys are blank or "mock", MockLlmProvider provides deterministic responses.
# ------------------------------------------------------------------------------
# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# OpenRouter API (Access to hundreds of models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto

# Nous Research / Portal API
NOUS_PORTAL_API_KEY=
NOUS_PORTAL_MODEL=hermes-3-llama-3.1-405b

# Local Ollama Endpoint (Default: http://localhost:11434)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default Router Strategy: cost_optimized | quality_optimized | latency_optimized | round_robin | offline_mock
ROUTER_DEFAULT_STRATEGY=offline_mock

# ------------------------------------------------------------------------------
# 3. OmniChannel Gateway Adapters
# When credentials are blank, channels operate with In-Memory Mock Adapters.
# ------------------------------------------------------------------------------
# Telegram Bot Adapter
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Discord Bot Adapter
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Slack Bot Adapter (Socket Mode or Webhook)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# WhatsApp Business Cloud API Adapter
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Signal Messenger Adapter (via local signal-cli REST daemon)
SIGNAL_CLI_ENDPOINT=http://localhost:8080
SIGNAL_PHONE_NUMBER=

# Email Adapter (IMAP incoming / SMTP outgoing)
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USE_SSL=true
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=

EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Humanized Computer Control & Safety
# ------------------------------------------------------------------------------
# Input Mode: Win32Native (real OS events) | MockSimulator (in-memory tracking)
HUMOFA_INPUT_SIMULATOR=MockSimulator

# Fitts's Law Movement Parameters (Milliseconds)
FITTS_A=50.0
FITTS_B=150.0

# Natural Typing Speed Range (Characters per minute)
TYPING_CADENCE_MIN_CPM=180
TYPING_CADENCE_MAX_CPM=350

# Panic Kill-Switch Sensitivity
PANIC_MOUSE_DELTA_THRESHOLD_PX=200
PANIC_MAX_LATENCY_MS=10

# Smart Approval Risk Threshold: green (auto) | yellow (notify) | red (explicit approval)
SMART_APPROVAL_DEFAULT_TIER=yellow

# ------------------------------------------------------------------------------
# 5. Persistent Memory & Skills Hub
# ------------------------------------------------------------------------------
HUMOFA_DATA_DIR=./data
HUMOFA_SQLITE_DB_PATH=./data/humofa_memory.db
HUMOFA_GITHUB_TOKEN=
SKILLGUARD_ENABLE_AST_SCAN=true

# ------------------------------------------------------------------------------
# 6. Execution Backends
# When remote backend credentials are blank, fallback to Local or Mock backend.
# ------------------------------------------------------------------------------
# Docker Backend
DOCKER_HOST=npipe://./pipe/docker_engine
DOCKER_SECURE_HARDENED=true

# SSH Backend
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_PRIVATE_KEY_PATH=

# Singularity / Apptainer Backend
SINGULARITY_CONTAINER_PATH=

# Modal Serverless Backend
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
